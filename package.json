{
  "name": "taskbar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "vite build",
    "start": "vite build && electron . --prod",
    "test": "node --test",
    "dist": "vite build && electron-builder --mac dir",
    "install-app": "npm run dist && (pkill -x 'Task Bar' || true) && rm -rf '/Applications/Task Bar.app' && cp -R 'release/mac-arm64/Task Bar.app' /Applications/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.local.taskbar",
    "productName": "Task Bar",
    "files": [
      "main.js",
      "gitlab.js",
      "reviewer.js",
      "preload.cjs",
      "icon.png",
      "dist/**"
    ],
    "mac": {
      "icon": "icon.png",
      "target": "dir",
      "identity": null
    },
    "directories": {
      "output": "release"
    }
  }
}
